# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL="mysql://usuario:senha@localhost:3306/cabofriooutlet"
PORT=3003
# Em produção use NODE_ENV=production: restringe o CORS ao SITE_URL e desliga o Swagger UI.
NODE_ENV=development
# Atrás de proxy (Nginx, Render...), defina 1 para o limite de tentativas enxergar o IP real.
TRUST_PROXY=
# URL pública do site (sem barra no final). Usada em canonical, Open Graph e sitemap.
SITE_URL=http://localhost:3003
JWT_SECRET=troque-por-um-segredo-longo
ADMIN_EMAIL=admin@exemplo.com
ADMIN_DEFAULT_PASSWORD=troque-esta-senha

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# E-mail transacional (Resend). Sem isso, o envio é simplesmente ignorado.
RESEND_API_KEY=
# Remetente com domínio verificado na Resend, ex: Cabo Frio Outlet <pedidos@seudominio.com.br>
EMAIL_FROM=

# Avaliações do Google (Places API New). O Place ID é configurado no painel admin.
GOOGLE_PLACES_API_KEY=
