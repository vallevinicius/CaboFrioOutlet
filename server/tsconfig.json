{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // NodeNext = as regras reais do Node em ES Modules: import relativo SEM ".js" vira erro de compilação
    // (foi isso que quebrou o servidor em produção: "Cannot find module .../dist/routes/auth").
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": false,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["dist", "**/*.test.ts", "test"]
}
