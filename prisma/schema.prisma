datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id              String        @id @default(cuid())
  name            String
  price           Float
  category        String
  brand           String?
  image           String
  description     String        @db.Text
  isNew           Boolean       @default(false)
  discountPercent Float?
  weightKg        Float         @default(0.3)
  heightCm        Float         @default(4)
  widthCm         Float         @default(20)
  lengthCm        Float         @default(25)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sizes           ProductSize[]
  orderItems      OrderItem[]
}

model ProductSize {
  id        String  @id @default(cuid())
  size      String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerContact String
  total           Float
  shippingCost    Float       @default(0)
  shippingService String?
  shippingCep     String?
  shippingStreet  String?
  shippingNumber  String?
  shippingComplement String?
  shippingNeighborhood String?
  shippingCity    String?
  shippingState   String?
  status          String      @default("pendente")
  paymentId       String?
  paymentMethod   String?
  paymentStatus   String?
  installments    Int?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  image       String
  size        String
  quantity    Int
  unitPrice   Float
}

model Settings {
  id                    Int    @id @default(1)
  storeName             String @default("Cabo Frio Outlet")
  freeShippingThreshold Float  @default(299)
  shippingFee           Float  @default(19.9)
  originCep             String  @default("")
  melhorEnvioToken      String? @db.Text
  melhorEnvioSandbox    Boolean @default(true)
  announcementMessages  String @db.Text
  brands                String @db.Text
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  eyebrow   String   @default("")
  title     String
  highlight String   @default("")
  subtitle  String   @default("")
  ctaLabel  String   @default("Ver Coleção")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String   @unique @default("")
  phone        String   @default("")
  cep          String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String?
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
}
