datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id              String        @id @default(cuid())
  name            String
  price           Float
  category        String
  brand           String?
  image           String
  description     String        @db.Text
  isNew           Boolean       @default(false)
  discountPercent Float?
  /// Onde a peça é vendida: só na loja (varejo), só no atacado ou nos dois.
  channel         SalesChannel  @default(BOTH)
  weightKg        Float         @default(0.3)
  heightCm        Float         @default(4)
  widthCm         Float         @default(20)
  lengthCm        Float         @default(25)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sizes           ProductSize[]
  images          ProductImage[]
  favorites       Favorite[]
  orderItems      OrderItem[]
}

enum SalesChannel {
  RETAIL
  WHOLESALE
  BOTH
}

model ProductSize {
  id        String  @id @default(cuid())
  size      String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerContact String
  /// Telefone/WhatsApp do cliente na hora da compra (só números). Pedidos antigos: nulo.
  customerPhone   String?
  /// CPF do cliente na hora da compra, cifrado (AES-256-GCM). Pedidos antigos: nulo.
  customerCpf     String?
  total           Float
  shippingCost    Float       @default(0)
  shippingService String?
  shippingCep     String?
  shippingStreet  String?
  shippingNumber  String?
  shippingComplement String?
  shippingNeighborhood String?
  shippingCity    String?
  shippingState   String?
  status          String      @default("pendente")
  paymentId       String?
  paymentMethod   String?
  paymentStatus   String?
  /// Motivo informado pelo Mercado Pago (ex.: cc_rejected_other_reason, accredited).
  paymentStatusDetail String?
  installments    Int?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  /// Pedido feito pela página de atacado (desconto por quantidade aplicado pelo servidor).
  isWholesale     Boolean     @default(false)
  wholesaleDiscountPercent Float?
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  image       String
  size        String
  quantity    Int
  unitPrice   Float
}

model Settings {
  id                    Int    @id @default(1)
  storeName             String @default("Cabo Frio Outlet")
  freeShippingThreshold Float  @default(299)
  shippingFee           Float  @default(19.9)
  originCep             String  @default("")
  /// Token de acesso da Melhor Envio (OAuth, vale 30 dias), cifrado. Renovado sozinho pelo servidor.
  melhorEnvioToken      String? @db.Text
  /// Token de renovação (vale 45 dias), cifrado.
  melhorEnvioRefreshToken String? @db.Text
  /// Quando o token de acesso vence.
  melhorEnvioTokenExpiresAt DateTime?
  melhorEnvioSandbox    Boolean @default(true)
  announcementMessages  String @db.Text
  brands                String @db.Text
  whatsapp              String  @default("")
  contactEmail          String  @default("")
  /// JSON: [{ label, hours }]. Nulo = usa o horário padrão definido no código.
  openingHours          String? @db.Text
  googlePlaceId         String  @default("")
  /// JSON: string[] da faixa amarela da home. Nulo = usa o texto padrão do código.
  tickerMessages        String? @db.Text
  /// Seção "anos vestindo a cidade" da home. Vazio/nulo = usa o texto padrão do código.
  storyTitle            String  @default("")
  storyBody             String? @db.Text
  /// Medição (só carrega no navegador após o consentimento do visitante).
  gaMeasurementId       String  @default("")
  metaPixelId           String  @default("")
  /// Pedido mínimo do atacado, em peças.
  wholesaleMinPieces    Int     @default(10)
  /// Condições do atacado, uma por linha. Nulo = texto padrão do código.
  wholesaleNotes        String? @db.Text
  /// JSON: [{ minPieces, discountPercent }]. Nulo = faixas padrão do código.
  wholesaleTiers        String? @db.Text
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  eyebrow   String   @default("")
  title     String
  highlight String   @default("")
  subtitle  String   @default("")
  ctaLabel  String   @default("Ver Coleção")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// CPF cifrado (AES-256-GCM, formato "enc:v1:..."). A unicidade vale no cpfHash.
  cpf          String   @default("")
  /// Carimbo (HMAC) do CPF: barra conta duplicada sem revelar o número. Nulo em conta sem CPF.
  cpfHash      String?  @unique
  phone        String   @default("")
  cep          String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String?
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  /// Pertence à equipe e entra no painel /admin. O que pode fazer vem de `role`.
  isAdmin      Boolean  @default(false)
  /// Admin supremo: acessa tudo e é o único que gerencia equipe e perfis. Definido só pelo seed.
  isSuperAdmin Boolean  @default(false)
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  orders       Order[]
  favorites    Favorite[]

  @@index([roleId])
}

/// Perfil de acesso do painel: define, por tela, se o usuário só vê ou também edita.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  /// Perfil de sistema ("Administrador"): não pode ser editado nem apagado.
  system      Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

/// Uma linha por tela com acesso. Sem linha = Nenhum.
model RolePermission {
  roleId  String
  /// inicio, banners, produtos, estoque, pedidos, atacado, clientes ou configuracoes
  section String
  level   PermissionLevel
  role    Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, section])
}

enum PermissionLevel {
  VIEW
  EDIT
}

/// Fotos adicionais do produto (a capa continua em Product.image).
model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId, position])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// Pedido de orçamento de atacado enviado pelo formulário público.
model WholesaleQuote {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  name          String
  company       String   @default("")
  cnpj          String   @default("")
  phone         String
  email         String
  city          String
  state         String
  interests     String   @default("")
  estimatedPieces Int?
  message       String?  @db.Text
  /// Peças escolhidas no site: [{ productId, name, size, quantity, unitPrice }]. Preços calculados pelo servidor.
  items         Json?
  estimatedTotal Float?
  discountPercent Float?
  handled       Boolean  @default(false)

  @@index([handled, createdAt])
}
